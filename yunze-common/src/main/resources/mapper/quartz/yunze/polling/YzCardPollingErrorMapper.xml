<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunze.common.mapper.yunze.polling.YzCardPollingErrorMapper">



    <insert id="save" parameterType="java.util.HashMap"  >
        insert into
           yz_card_polling_error
        (
            iccid,
            codeOn,
            message,
            cd_code,
            create_date,
            upd_date,
            is_notice,
            rt_map
        )
        value
        (
            #{iccid},
            #{codeOn},
            #{message},
            #{cd_code},
            now(),
            now(),
            1,
            #{rt_map}
        )
    </insert>

    <select id="findEx" parameterType="java.util.HashMap" resultType="java.lang.String">
        select
        id
        from
        yz_card_polling_error
        <where>
            iccid = #{iccid}
            and codeOn = #{codeOn}
        </where>
        LIMIT 1
    </select>

    <!--批量删除-->
    <delete id="delArr" parameterType="java.util.HashMap">
        DELETE from yz_card_polling_error
        <where>
            id in
            <foreach item="DeleArr" collection="DeleArr" index="DeleArr" open="(" separator="," close=")">
                #{DeleArr}
            </foreach>
        </where>
    </delete>

    <!--批量修改-->
    <update id="updArr" parameterType="java.util.HashMap">
        UPDATE yz_card_polling_error
        <set>
            is_notice =#{is_notice},
            upd_date = now()
        </set>
        <where>
            id in
            <foreach item="UpdaArr" collection="UpdaArr" index="UpdaArr" open="(" separator="," close=")">
                #{UpdaArr}
            </foreach>
        </where>
    </update>


    <!--单个修改-->
    <update id="updObj" parameterType="java.util.HashMap">
        update yz_card_polling_error
        <set>
            is_notice =#{is_notice},
            upd_date = now()
        </set>
        <where>
            id =#{id}
        </where>
    </update>




    <update id="upd" parameterType="java.util.HashMap"  >
        update yz_card_polling_error
        <set>
            message = #{message},
            cd_code = #{cd_code},
            rt_map = #{rt_map},
            upd_date = now()
        </set>
        <where>
            id = #{id}
        </where>
    </update>



    <!--单个删除-->
    <delete id="del" parameterType="java.util.HashMap">
        delete from yz_card_polling_error
        <where>id =#{id}</where>
    </delete>


    <select id="findGroup" parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT cd_code,
               codeOn,
               message,
               count(1) as 'ct_sum'
        FROM yz_card_polling_error
        GROUP BY cd_code,
                 codeOn
    </select>


    <select id="selMap" parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
        id,
        iccid,
        codeOn,
        message,
        cd_code,
        DATE_FORMAT( create_date, "%Y-%m-%d %H:%i:%S" ) AS 'create_date',
        DATE_FORMAT( upd_date, "%Y-%m-%d %H:%i:%S" ) AS 'upd_date',
        is_notice,
        CONVERT(rt_map USING utf8mb4) AS rt_map
        FROM
        yz_card_polling_error
        <include refid="whereComm"/>
        LIMIT #{StarRow},#{PageSize}
    </select>


    <select id="selMapCount" parameterType="java.util.HashMap" resultType="java.lang.Integer">
        SELECT
        count(1)
        FROM
        yz_card_polling_error
        <include refid="whereComm"/>
    </select>


    <sql id="whereComm">
        <where>
            <if test="is_notice!=null and is_notice != ''">
                is_notice = #{is_notice}
            </if>
            <if test="isToDay!=null and isToDay==1">
                and   upd_date = CURDATE()
            </if>
            <if test="cd_code != null and cd_code != ''">
                and cd_code =#{cd_code}
            </if>
            <if test="timetype != null  and timetype != '' and staTime!=null and endTime!=null">
                AND
                <if test="timetype == 1">
                 create_date
                </if>
                <if test="timetype == 2">
                    upd_date
                </if>
                BETWEEN #{staTime} AND #{endTime}
            </if>
            <if test="value!=null and value!='' ">
                <if test="type==1">
                    and iccid LIKE CONCAT(#{value},'%')
                </if>
                <if test="type==2">
                    and codeOn LIKE CONCAT(#{value},'%')
                </if>
                <if test="type==3">
                    and message LIKE CONCAT(#{value},'%')
                </if>
            </if>
        </where>
    </sql>



    <select id="selMapRelevance" parameterType="java.util.HashMap"  resultType="java.util.HashMap">
        SELECT
        a.id,
        a.iccid,
        a.codeOn,
        a.message,
        a.cd_code,
        DATE_FORMAT( a.create_date, "%Y-%m-%d %H:%i:%S" )  AS 'create_date',
        DATE_FORMAT( a.upd_date, "%Y-%m-%d %H:%i:%S" )  AS 'upd_date',
        a.is_notice,
        c.cd_id,
        c.cd_name,
        c.cd_alias,
        c.cd_useraccount
        FROM
        yz_card_polling_error a,
        yz_card_info b,
        yz_card_route c
        <where>
            a.iccid = b.iccid
            and b.channel_id = c.cd_id
            <if test="is_notice!=null">
                and is_notice = #{is_notice}
            </if>
            <if test="isToDay!=null and isToDay==1">
                and   upd_date = CURDATE()
            </if>
            <if test="codeOnArr!=null and codeOnArr != '' and codeOnArr.size>0">
                and codeOn
                <if test="notIn!=null and notIn ==1">
                    not
                </if>
                in
                <foreach item="codeOnArr" collection="codeOnArr" index="codeOnArr" open="(" separator="," close=")">
                    #{codeOnArr}
                </foreach>
            </if>
            <if test="cdCodeArr!=null and cdCodeArr != '' and cdCodeArr.size>0">
                and a.cd_code
                in
                <foreach item="cdCodeArr" collection="cdCodeArr" index="cdCodeArr" open="(" separator="," close=")">
                    #{cdCodeArr}
                </foreach>
            </if>
        </where>
        <if test="isGroupBy!=null and isGroupBy==1">
            GROUP BY codeOn,b.channel_id
        </if>
    </select>


    <delete id="delTime" parameterType="java.util.HashMap">
		delete from yz_card_polling_error
		where
	 	 create_date  <![CDATA[ < ]]> #{delTime}
	</delete>


</mapper>





























