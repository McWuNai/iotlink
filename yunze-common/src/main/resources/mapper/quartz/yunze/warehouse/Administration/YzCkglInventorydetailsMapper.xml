    <!-- 按批次号分组 -->
    <select id="groupByBatchNumber" parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
            batchNumber,
            COUNT(1) as 'count'
        FROM
            yz_ckgl_inventorydetails
        <include refid="selwhere"/>
        group by batchNumber

    </select>

    <!-- 按商品id分组 -->
    <select id="groupByCyID" parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
            CSDS_CyID,
            COUNT(1) as 'count'
        FROM
            yz_ckgl_inventorydetails a,
            yz_ckgl_commodity b
        <where>
            a.CSDS_CyID = b.Cy_ID
            <if test="timetype != null  and timetype != '' and staTime!=null and endTime!=null">
                AND
                <if test="timetype == 1">
                     a.create_time
                </if>
                <if test="timetype == 2">
                     enteringwarehousetime
                </if>
                BETWEEN #{staTime} AND #{endTime}
            </if>
            <if test="dept_id != null  and dept_id != '' and dept_id!=null and dept_id!=null">
                and a.dept_id = #{dept_id}
            </if>

        </where>
        group by CSDS_CyID

    </select>

    <!-- 按商品id分组 -->
    <select id="getPolyline" parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
            <if test="FindType == 'day'">
                DATE_FORMAT( enteringwarehousetime, "%m-%d"  ) as 'monthDay',
            </if>
            <if test="FindType == 'month'">
                DATE_FORMAT( enteringwarehousetime, "%Y-%m"  ) as 'yearMonth',
            </if>
            COUNT(1) as 'count'
        FROM
            yz_ckgl_inventorydetails
        <where>
            <if test="timetype != null  and timetype != '' and staTime!=null and endTime!=null">
                AND
                <if test="timetype == 1">
                     create_time
                </if>
                <if test="timetype == 2">
                     enteringwarehousetime
                </if>
                BETWEEN #{staTime} AND #{endTime}
            </if>
            <if test="dept_id != null  and dept_id != '' and dept_id!=null and dept_id!=null">
                and dept_id = #{dept_id}
            </if>
        </where>
        <if test="FindType == 'day'">
            GROUP BY monthDay
            ORDER BY enteringwarehousetime asc
        </if>
        <if test="FindType == 'month'">
            GROUP BY yearMonth
            ORDER BY enteringwarehousetime asc
        </if>

    </select>


</mapper>













