    <insert id="importStock" parameterType="java.util.HashMap">
        insert into
        yz_ckgl_inventorydetails
        (
        CaseNumber,
        PlateNumber,
        productCode,
        arraylNumber,
        batchNumber,
        Pkg_Id,
