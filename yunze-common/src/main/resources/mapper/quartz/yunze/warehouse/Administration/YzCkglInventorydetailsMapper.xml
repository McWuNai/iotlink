    <!--筛选 IMEI-->
    <select id="iMEIStock" parameterType="java.util.HashMap" resultType="java.lang.String">
        SELECT
        <if test="type==1">
            IMEI
        </if>
        FROM
        yz_ckgl_inventorydetails
        <where>
            <if test="type==1">
                IMEI
            </if>
            IN
            <foreach item="Import_arrs" collection="Import_arrs" index="Import_arrs" separator="," open="(" close=")">
                <if test="type==1">
                    #{Import_arrs.IMEI}
                </if>
            </foreach>
        </where>
    </select>


