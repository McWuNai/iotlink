    <!-- 卡所属划分 -->
    <update id="updateDivid" parameterType="java.util.HashMap">
        UPDATE yz_ckgl_inventorydetails
        <set>
            dept_id = #{set_dept_id},
            user_id = #{set_user_id}
        </set>
        <where>
            id in
            <foreach item="idArr" collection="idArr" index="idArr" open="("  separator=","  close=")">
                #{idArr}
            </foreach>
        </where>
    </update>

