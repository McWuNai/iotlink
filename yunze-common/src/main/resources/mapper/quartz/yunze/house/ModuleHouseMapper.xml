                <if test="type == 19">
                mac =#{value}
                </if>
                <if test="type == 20">
                iccid =#{value}
                </if>
                <if test="type == 21">
                imsi =#{value}
                </if>
                <if test="type == 22">
                reel_number =#{value}
                </if>
                <if test="type == 23">
                firmware_version =#{value}
                </if>
            </if>
            <if test="timetype != null  and timetype != '' and staTime!=null and endTime!=null">
                AND
                <if test="timetype == 1">
                    create_time
                </if>
                <if test="timetype == 2">
                    delivery_time
                </if>
                BETWEEN #{staTime} AND #{endTime}
            </if>
            <if test="StartAndEndtype != null  and StartAndEndtype != '' and StartValue!=null and EndValue!=null">
                AND
                <if test="StartAndEndtype == 0">
                    serial_number
                </if>
                <if test="StartAndEndtype == 1">
                    middle_box_number
                </if>
                <if test="StartAndEndtype == 2">
                    device_serial
                </if>
                <if test="StartAndEndtype == 3">
                    device_id
                </if>
                <if test="StartAndEndtype == 4">
                    sn
                </if>
                <if test="StartAndEndtype == 5">
                    original_sn
                </if>
                <if test="StartAndEndtype == 6">
                    mac
                </if>
                <if test="StartAndEndtype == 7">
                    iccid
                </if>
                <if test="StartAndEndtype == 8">
                    imsi
                </if>
                <if test="StartAndEndtype == 9">
                    reel_number
                </if>
                BETWEEN #{StartValue} AND #{EndValue}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>
