	<insert id="save" parameterType="java.util.HashMap">
		insert into yz_card_flow_his
		(
		total_flow,
		total_flow_now,
		month,
		year,
		day,
		iccid,
		create_time,
		total_show_flow,
		total_show_flow_now
		)
		values
		(
		<choose>
			<when test="total_flow != null and total_flow != ''">
				#{total_flow}
			</when>
			<otherwise>
				0.00
			</otherwise>
		</choose>,

		<choose>
			<when test="total_flow_now != null and total_flow_now != ''">
				#{total_flow_now}
			</when>
			<otherwise>
				0.00
			</otherwise>
		</choose>,

		#{month},
		#{year},
		#{day},
		#{iccid},
		now(),

		<choose>
			<when test="total_show_flow != null and total_show_flow != ''">
				#{total_show_flow}
			</when>
			<otherwise>
				0.00
			</otherwise>
		</choose>,

		<choose>
			<when test="total_show_flow_now != null and total_show_flow_now != ''">
				#{total_show_flow_now}
			</when>
			<otherwise>
				0.00
			</otherwise>
		</choose>
		)
	</insert>

