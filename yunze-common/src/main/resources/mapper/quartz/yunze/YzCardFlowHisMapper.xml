	<update id="edit" parameterType="java.util.HashMap">
		update yz_card_flow_his
		<set>
			<!-- 只有在 total_flow 存在且非空时才更新 -->
			<if test="total_flow != null and total_flow != ''">
				total_flow = #{total_flow},
			</if>
			<!-- 只有在 total_flow_now 存在且非空时才更新 -->
			<if test="total_flow_now != null and total_flow_now != ''">
				total_flow_now = #{total_flow_now},
			</if>
			<!-- 无论如何都会更新 update_time -->
			update_time = now(),
			<!-- 只有在 total_show_flow 存在且非空时才更新 -->
			<if test="total_show_flow != null and total_show_flow != ''">
				total_show_flow = #{total_show_flow},
			</if>
			<!-- 只有在 total_show_flow_now 存在且非空时才更新 -->
			<if test="total_show_flow_now != null and total_show_flow_now != ''">
				total_show_flow_now = #{total_show_flow_now},
			</if>
		</set>
		<where>
			iccid = #{iccid}
			AND `year` = #{year}
			AND `month` = #{month}
			AND `day` = #{day}
		</where>
	</update>

	<select id="isExist" parameterType="java.util.HashMap" resultType="java.lang.Integer">
		SELECT
			COUNT(iccid)
		FROM
			yz_card_flow_his
		<where>
			iccid = #{iccid}
			AND `year` = #{year}
			AND `month` = #{month}
			AND `day` = #{day}
		</where>
	</select>





</mapper>