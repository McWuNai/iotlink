<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunze.cn.mapper.YzVWhiteMapper">

    <select id="selRoute"  parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
            channel_id
        FROM
            yz_card_info
        where
            iccid = #{iccid}

    </select>

    <select id="selRouteCreate"  parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
            cd_code,cd_name,cd_username,cd_pwd,cd_key
        FROM
            yz_card_route
        where
            cd_id = #{channel_id} and cd_status= '1'

    </select>
    <select id="getPacketForIccid"  parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
            package_id
        FROM
            yz_card_info
        where
            iccid=#{iccid}

    </select>
    <select id="getPreForPacket"  parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT
            count(*) as pre
        FROM
            yz_wx_packet_use
        where
            p_id=#{package_id} and status = 0

    </select>

</mapper>
